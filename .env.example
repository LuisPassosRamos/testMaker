# Prova Pronta — configuração. Copie para ".env" (o instalador faz isso) e ajuste o que precisar.
# Nunca coloque este arquivo .env no GitHub: ele pode conter senhas.

# ---------------------------------------------------------------- No ar (servidor) — veja docs/DEPLOY.md
# Endereço público do site (usado pelo Caddy para o HTTPS automático).
SITE_ADDRESS=
# Código que os professores digitam uma vez por aparelho. Deixe vazio só para uso local.
# Maiúsculas, acentos e espaços não importam. Trocar o código desconecta todos os aparelhos.
ACCESS_CODE=
# Banco de dados PostgreSQL (ex.: Neon gratuito). Guarda provas, arquivos e modelos de cabeçalho.
# Vazio = tudo fica só na pasta data/ deste computador.
DATABASE_URL=
# Tarefas em paralelo (leitura/PDF). Use 1 em servidores com 512 MB de memória.
JOB_WORKERS=2

# ---------------------------------------------------------------- E-mail para impressão
# outbox = modo de teste: o e-mail é salvo em data/outbox (nada é enviado)
# smtp   = envio real
MAIL_MODE=outbox
MAIL_TO=escolamadre2impressoes@gmail.com

# Para Gmail: use uma conta da escola, ative a verificação em duas etapas e crie uma
# "senha de app" em https://myaccount.google.com/apppasswords (não use a senha normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------- Inteligência artificial
# Sem nenhuma chave, o site funciona com a leitura por regras e esconde os recursos de IA.
# Cada serviço com chave entra numa fila: quando um atinge o limite grátis ou falha, o próximo é usado.
# Chaves grátis (sem cartão): Google AI Studio, Groq, Mistral, OpenRouter. Veja docs/DEPLOY.md.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Heroku Managed Inference (pago pelo crédito; o add-on preenche estas duas sozinho no Heroku).
# INFERENCE_URL=
# INFERENCE_KEY=
# AI_MODEL_READ=claude-haiku-5-5
# AI_MODEL_WRITE=claude-sonnet-5-5
# Ordem da fila: "serviço" ou "serviço:modelo", separados por vírgula. Os padrões já servem.
# AI_CHAIN_READ=heroku,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,gemini:gemini-3.8-flash,mistral:mistral-small-latest,openrouter:openrouter/free
# AI_CHAIN_WRITE=heroku,gemini:gemini-3.8-flash,mistral:mistral-large-latest,gemini:gemini-3.5-flash-lite,openrouter:openrouter/free,groq:openai/gpt-oss-120b
# auto = usa todos os configurados · off = desliga · ou o nome de um serviço só (gemini, groq…)
AI_PROVIDER=auto
# Organizar automaticamente com IA toda prova enviada (cada prova pode escolher "ler sem IA").
AI_READING=true
# Pedidos de criação/refazer por aparelho por hora (protege as cotas grátis).
MAX_AI_REQUESTS_PER_HOUR=40

# ---------------------------------------------------------------- Privacidade e limites
# Provas não alteradas há mais que este número de horas são apagadas automaticamente.
RETENTION_HOURS=72
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=40

# ---------------------------------------------------------------- Ferramentas (normalmente detectadas sozinhas)
# CONVERTER=auto            # auto | libreoffice | word
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_DIR=backend\vendor\tessdata
# DATA_DIR=data
